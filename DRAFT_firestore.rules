rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // For Google Auth, email_verified is usually true. 
      // If some accounts fail, we can relax it, but strict policy demands it.
      return request.auth.token.email_verified == true;
    }

    // Entity Checkers
    function isValidExam(data) {
      return data.keys().hasAll(['title', 'timeLimit', 'createdAt', 'ownerId', 'questions']) &&
             data.keys().size() == 5 &&
             data.title is string && data.title.size() <= 200 &&
             data.timeLimit is number &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.questions is list && data.questions.size() <= 200;
             // We can assume questions[0] check isn't fully required if size is 0, 
             // but if we want to be hyper strict: 
             // (data.questions.size() == 0 || (data.questions.size() > 0 && data.questions[0] is map));
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['examId', 'teacherId', 'studentName', 'answers', 'score', 'maxScore', 'submittedAt']) &&
             data.keys().size() == 7 &&
             data.examId is string && data.examId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.answers is map &&
             data.score is number &&
             data.maxScore is number &&
             data.submittedAt is string && data.submittedAt.size() <= 100;
    }

    // Collections
    
    match /exams/{examId} {
      allow get: if isValidId(examId); // public for student to view
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isValidId(examId) &&
                       isSignedIn() && isVerified() && 
                       isValidExam(incoming()) && 
                       incoming().ownerId == request.auth.uid;
                       
      // Actions: Edit Exam questions and limits
      allow update: if isValidId(examId) &&
                       isSignedIn() && isVerified() &&
                       existing().ownerId == request.auth.uid &&
                       isValidExam(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'timeLimit', 'questions']);
                       
      allow delete: if isValidId(examId) &&
                       isSignedIn() && 
                       existing().ownerId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && existing().teacherId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      
      allow create: if isValidId(submissionId) &&
                       isValidSubmission(incoming()) &&
                       exists(/databases/$(database)/documents/exams/$(incoming().examId)) &&
                       get(/databases/$(database)/documents/exams/$(incoming().examId)).data.ownerId == incoming().teacherId;
                       
      allow update: if false; // Students cannot edit, teachers cannot edit
      allow delete: if false; // No deletion of submissions modeled right now
    }
  }
}
